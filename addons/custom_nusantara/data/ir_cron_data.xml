<odoo>
    <record id="ir_cron_nusantara_reminder" model="ir.cron">
        <field name="name">Reminder Pendaftaran Event Tanpa Email</field>
        <field name="model_id" ref="model_nusantara_event_registration"/>
        <field name="state">code</field>
        <field name="code">model._cron_reminder_pendaftaran()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>